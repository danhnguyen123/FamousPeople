# Claude (identify subject + write visual briefs). The SDK also accepts `ant auth login`.
ANTHROPIC_API_KEY=
# DOCUGEN_MODEL=claude-opus-5-5

# Wikimedia requires a descriptive User-Agent with a contact address.
DOCUGEN_USER_AGENT=docugen/0.1 (https://github.com/danhnguyen123/FamousPeople; you@example.com)

# Optional sources
PEXELS_API_KEY=            # generic / mood scenes
BRAVE_API_KEY=             # open web discovery, only used with DOCUGEN_LICENSE_POLICY=review

# strict = only public domain / Creative Commons / stock licenses
# review = also web finds (magazine scans, fan archives), flagged in credits.txt for rights review
DOCUGEN_LICENSE_POLICY=strict
DOCUGEN_BLOCKED_DOMAINS=               # comma separated, e.g. fandom.com,reddit.com
DOCUGEN_PREFERRED_DOMAINS=             # comma separated, up to 5 trusted archives
DOCUGEN_CLIP=auto                      # off to skip CLIP reranking

# Narration (ElevenLabs, with character timestamps)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                   # default voice
# ELEVENLABS_VOICE_DE=                 # per-language override (EN, FR, DE, IT, PL, NL)
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Rendering in containers without Remotion's own Chrome download
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome-headless-shell
