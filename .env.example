# Keys: on your own machine put them here. In a Claude Code cloud environment, add the
# search keys as API credentials instead (see docs/PIPELINE.md); they are then not needed here.

# Claude: plan (SRT to scenes, groups, keywords) and select (checks search results).
# The SDK also accepts `ant auth login`. Cloud sessions reserve ANTHROPIC_API_KEY for
# Claude Code itself: use DOCUGEN_ANTHROPIC_API_KEY there.
ANTHROPIC_API_KEY=
# DOCUGEN_ANTHROPIC_API_KEY=
# DOCUGEN_MODEL=claude-opus-5-5
# DOCUGEN_SELECT_MODEL=claude-opus-5-5   # defaults to DOCUGEN_MODEL
# DOCUGEN_SELECT_EFFORT=medium           # effort of the select step (low, medium, high)
# DOCUGEN_SELECT_BATCH=1                 # Batches API: half price, a few minutes of waiting

# Image search: {search engine: API provider}, every engine queried for every group.
# google: dataforseo | searchapi | serper   bing: searchapi   brave: brave
# Remove an engine from the object to turn it off.
DOCUGEN_SEARCH='{"google": "dataforseo", "bing": "searchapi", "brave": "brave"}'

# Google Images through DataForSEO (https://app.dataforseo.com/api-access)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# DOCUGEN_DATAFORSEO_LIVE=1              # instant results at $0.002 instead of the $0.0006 queue
# DATAFORSEO_LOCATION_CODE=2826          # override the country (default follows --lang; 2826 = UK)

# Google Images through Serper (https://serper.dev)
SERPER_API_KEY=

# Google and Bing Images through SearchAPI.io (https://www.searchapi.io)
SEARCHAPI_API_KEY=

# Brave Image Search (https://api-dashboard.search.brave.com)
BRAVE_API_KEY=
# DOCUGEN_BRAVE_SAFESEARCH=strict        # strict or off
# DOCUGEN_BRAVE_COUNTRY=DE
# DOCUGEN_BRAVE_INTERVAL=1.1             # seconds between Brave calls (free plan: 1 per second)

# DOCUGEN_CANDIDATES_PER_SOURCE=40       # results per search engine sent to Claude for checking
# DOCUGEN_MIN_POOL=3                     # fewer accepted images than this: search the next keyword
# DOCUGEN_SCENES_PER_IMAGE=2             # also search it when the pool has under 1 image per 2 scenes
DOCUGEN_BLOCKED_DOMAINS=                 # comma separated, e.g. fandom.com,reddit.com
# DOCUGEN_USER_AGENT=...                 # for image downloads (default: a desktop browser)

# Review page (docugen review): Vietnamese translations through Gemini
# GEMINI_API_KEY=
# DOCUGEN_TRANSLATE_MODEL=gemini-3.8-flash

# Rendering in containers without Remotion's own Chrome download
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome-headless-shell
