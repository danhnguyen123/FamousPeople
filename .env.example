# Claude (Scene Analyzer: subject + 3 to 5 image queries per scene). The SDK also accepts `ant auth login`.
ANTHROPIC_API_KEY=
# DOCUGEN_MODEL=claude-opus-5-5

# Google Images through SerpApi (https://serpapi.com), one search per query
SERPAPI_API_KEY=
# SERPAPI_GL=us              # Google country, e.g. us, fr, de, it, pl, nl
# SERPAPI_TBS=isz:l          # Google image filters, isz:l = large images only
# DOCUGEN_MAX_QUERIES=4      # specific queries per scene (cost control)

# Image sources: google (SerpApi, default). Optional: wikimedia, openverse, pexels, web (Brave)
DOCUGEN_PROVIDERS=google
DOCUGEN_BLOCKED_DOMAINS=               # comma separated, e.g. fandom.com,reddit.com
DOCUGEN_PREFERRED_DOMAINS=             # comma separated trusted sites, ranked higher
DOCUGEN_CLIP=auto                      # off to skip CLIP reranking

# Descriptive User-Agent for image downloads and the optional archive sources
DOCUGEN_USER_AGENT=docugen/0.1 (https://github.com/danhnguyen123/FamousPeople; you@example.com)

# Only for the optional sources above
PEXELS_API_KEY=
BRAVE_API_KEY=

# Only for projects made from a .txt script (SRT projects bring their own audio)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE_DE=                 # per-language override (EN, FR, DE, IT, PL, NL)
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Rendering in containers without Remotion's own Chrome download
# REMOTION_BROWSER_EXECUTABLE=/path/to/chrome-headless-shell
